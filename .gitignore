# Monorepo Root .gitignore
# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build outputs
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# Testing & Coverage
coverage/
**/coverage/

# Environment variables & Local secrets
.env
.env.*
.env*.local
**/.env*
!**/.env.example
serviceAccountKey.json
**/serviceAccountKey.json
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json

# Vercel
.vercel/
**/.vercel/

# TypeScript cache
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Misc & OS files
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
